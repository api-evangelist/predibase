          "name": "Create a fine-tuning job.",
          "request": {
            "name": "Create a fine-tuning job.",
            "description": {
              "content": "Starts a supervised or reinforcement (GRPO) fine-tuning job that trains a LoRA / Turbo LoRA adapter on a base model using a connected dataset, producing a new adapter version in the target repository.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "finetuning",
                "jobs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Predibase tenant ID.",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                },
                {
                  "description": "Deployment name (base model deployment).",
                  "type": "any",
                  "value": "{{model}}",
                  "key": "model"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"base_model\": \"<string>\",\n  \"dataset\": \"<string>\",\n  \"repo\": \"<string>\",\n  \"adapter_type\": \"<string>\",\n  \"task\": \"<string>\"\n}",
