          "name": "Create a batch inference job.",
          "request": {
            "name": "Create a batch inference job.",
            "description": {
              "content": "Launches an asynchronous batch inference job against a base model with optional per-row adapter selection. Predibase deploys the target base model and loads any required adapters automatically.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "batch-inference",
                "jobs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Predibase tenant ID.",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                },
                {
                  "description": "Deployment name (base model deployment).",
                  "type": "any",
                  "value": "{{model}}",
                  "key": "model"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
